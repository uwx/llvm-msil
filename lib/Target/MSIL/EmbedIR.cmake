# Turn a text file into a C++ string literal, so the built-in libc's IR ships
# inside the backend rather than as a data file the tool has to find at run
# time.
#
#   cmake -DINPUT=<file> -DOUTPUT=<file> [-DNAME=<symbol>] -P EmbedIR.cmake
#
# The literal is split at line boundaries, which keeps every line inside the
# length C++ implementations are required to accept.

if(NOT INPUT OR NOT OUTPUT)
  message(FATAL_ERROR "EmbedIR.cmake needs -DINPUT= and -DOUTPUT=")
endif()
if(NOT NAME)
  set(NAME PortableLibcIR)
endif()

file(READ "${INPUT}" CONTENT)

# Escape backslashes and quotes, and make sure a trailing newline does not
# run into the closing quote.
string(REPLACE "\\" "\\\\" CONTENT "${CONTENT}")
string(REPLACE "\"" "\\\"" CONTENT "${CONTENT}")
string(REPLACE "\n" "\\n\"\n\"" CONTENT "${CONTENT}")

set(OUT "\
// Generated by EmbedIR.cmake from the portable C library. Do not edit.
static const char ${NAME}[] =
\"" )

if(CONTENT)
  string(APPEND OUT "${CONTENT}")
endif()

string(APPEND OUT "\";\n")
file(WRITE "${OUTPUT}" "${OUT}")
