; RUN: llvm-msil %s -o - | FileCheck %s

; ilasm rejects a name over 1023 characters, which nested template manglings
; reach. A definition keeps the first part and gets a hash of the whole name,
; so every module computes the same spelling.

; CHECK: .method {{.*}} '{{long_x+}}${{[0-9a-f]+}}'()
define void @long_() {
  ret void
}

; CHECK-LABEL: 'main'()
; CHECK: call void '{{long_x+}}${{[0-9a-f]+}}'()
define void @main() {
  call void @long_()
  ret void
}
