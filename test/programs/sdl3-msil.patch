diff --git a/include/SDL3/SDL_atomic.h b/include/SDL3/SDL_atomic.h
index 5ef1f10..4224f2d 100644
--- a/include/SDL3/SDL_atomic.h
+++ b/include/SDL3/SDL_atomic.h
@@ -355,6 +355,8 @@ typedef void (*SDL_KernelMemoryBarrierFunc)();
  */
 #define SDL_CPUPauseInstruction() DoACPUPauseInACompilerAndArchitectureSpecificWay
 
+#elif defined(SDL_PLATFORM_MSIL)
+    #define SDL_CPUPauseInstruction()  /* no inline asm in CIL; a no-op is the documented fallback. */
 #elif (defined(__GNUC__) || defined(__clang__)) && (defined(__i386__) || defined(__x86_64__)) && !defined(__arm64ec__)
     #define SDL_CPUPauseInstruction() __asm__ __volatile__("pause\n")  /* Some assemblers can't do REP NOP, so go with PAUSE. */
